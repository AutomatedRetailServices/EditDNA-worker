# =========================================================
# 🎬 EditDNA.ai Worker Defaults — Unified v1.7 (Dec 2025)
# =========================================================

# ---------- Selection / funnel ----------
FUNNEL_COUNTS=2,3,2,1         # ~8 clips → ~24–32s
VETO_MIN_SCORE=0.35           # keep more candidates than 0.40
BIN_SEC=1.0                   # scoring bin size

# ---------- Clip bounds ----------
MIN_TAKE_SEC=1.5
MAX_TAKE_SEC=20
MAX_DURATION_SEC=120          # hard ceiling used by the picker

# ---------- ASR / captions (active production variables) ----------
ASR_ENABLED=1
# Active ASR model/device precedence:
# WHISPER_MODEL_NAME, then WHISPER_MODEL, then the built-in default "medium".
# WHISPER_DEVICE, then ASR_DEVICE, then the built-in default "auto".
# WHISPER_MODEL_NAME=medium
# WHISPER_MODEL=medium
# WHISPER_DEVICE=auto
# ASR_DEVICE=auto

# Legacy/currently unused by the active pipeline; retained for compatibility only.
ASR_MODEL_SIZE=tiny
ASR_LANG=en
CAPTIONS=off                  # off|soft|hard
V2_CAPTIONER=1

# ---------- Active optional model features (all disabled by default) ----------
# EDITDNA_USE_LLM=0
# EDITDNA_LLM_MODEL=gpt-5.1
# VISION_ENABLED=0
# VISION_INTERVAL_SEC=2.0
# VISION_MAX_SAMPLES=50
# W_VISION=0.7
# BAD_TAKES_ENABLED=0
# BOUNDARY_REFINER_ENABLED=0
# BOUNDARY_REFINER_MIN_DURATION_SEC=3.0
# BOUNDARY_REFINER_HEAD_STEP_SEC=1.5
# BOUNDARY_REFINER_TAIL_STEP_SEC=1.5
# TAKE_JUDGE_ENABLED=0
# TAKE_JUDGE_MODEL=gpt-4o-mini
# TAKE_JUDGE_MAX_GROUPS=6
# TAKE_JUDGE_MAX_TAKES=3
# TAKE_JUDGE_FRAMES=1

# ---------- Render quality (vertical) ----------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# =========================================================
# 🧠 Semantic + Visual Fusion (Continuity Engine)
# =========================================================
W_SEM=1.2
W_FACE=0.8
W_SCENE=0.5
W_VTX=0.8
SEM_DUP_THRESHOLD=0.88
SEM_MERGE_SIM=0.80
VIZ_MERGE_SIM=0.75
MERGE_MAX_CHAIN=3
SEM_FILLER_MAX_RATE=0.08

# Slot rules (optional)
SLOT_REQUIRE_PRODUCT=FEATURE,PROOF
SLOT_REQUIRE_OCR_CTA=CTA

# =========================================================
# ☁️ Core Runtime (no secrets)
# =========================================================
# Redis/RQ queue contract
QUEUE_NAME=default
RQ_JOB_TIMEOUT=3600
RQ_RESULT_TTL=86400
RQ_FAILURE_TTL=604800
# Conservative default: RQ otherwise retries every worker exception.
# Opt in only if that tradeoff is acceptable; classified transient retries TBD.
RQ_MAX_RETRIES=0
AWS_REGION=us-east-1
S3_BUCKET=script2clipshop-video-automatedretailservices

# =========================================================
# 📦 Dataset / training paths (Good + Bloopers)
# =========================================================
# Bucket where JSON outputs + training files live
EDITDNA_DATASET_BUCKET=script2clipshop-video-automatedretailservices

# Where all per-video JSONs live (bloopers + GoodX)
EDITDNA_TAKEJUDGE_PREFIX=editdna/outputs/dataset/bloopers/

# Where the merged JSONL dataset is stored
EDITDNA_TAKEJUDGE_DATASET_KEY=editdna/training/take_judge_dataset.jsonl

# Full S3 URI to the merged dataset file
EDITDNA_TAKE_JUDGE_DATASET_S3_URI=s3://script2clipshop-video-automatedretailservices/editdna/training/take_judge_dataset.jsonl

# =========================================================
# 🤖 Take Judge model (inference)
# =========================================================
# Legacy/currently unused by the active pipeline (not an alias for TAKE_JUDGE_ENABLED).
EDITDNA_TAKE_JUDGE_ENABLED=1

# Additional legacy names retained as documentation; the active pipeline does not read them.
# TAKEJUDGE_MODEL_URI=
# TAKEJUDGE_MIN_CONF=

# Trained model file in S3 (joblib you just created)
EDITDNA_TAKE_JUDGE_MODEL_S3_URI=s3://script2clipshop-video-automatedretailservices/editdna/models/take_judge_baseline.joblib

# Score threshold to mark a clip as keep=true (0–1)
EDITDNA_TAKE_JUDGE_THRESHOLD=0.55
